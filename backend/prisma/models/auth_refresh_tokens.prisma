model auth_refresh_tokens {
  token_hash  String        @id @db.Char(64)
  session_id  String        @db.Uuid
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  consumed_at DateTime?     @db.Timestamptz(6)
  session     auth_sessions @relation("auth_refresh_tokens_session", fields: [session_id], references: [id])

  @@index([session_id], map: "auth_refresh_tokens_session_idx")
  @@schema("workify")
}
