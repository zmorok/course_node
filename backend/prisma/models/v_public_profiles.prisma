view v_public_profiles {
  user_id                 String    @unique @db.Uuid
  username                String?
  first_name              String?
  last_name               String?
  headline                String?
  description             String?
  city                    String?
  country                 String?
  avatar_file_id          String?   @db.Uuid
  customer_rating         Decimal?
  customer_review_count   BigInt?
  freelancer_rating       Decimal?
  freelancer_review_count BigInt?
  middle_name             String?
  gender                  String?
  last_online_at          DateTime? @db.Timestamptz(6)

  @@schema("workify")
}
