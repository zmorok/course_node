model complaint_files {
  complaint_id String       @db.Uuid
  file_id      String       @db.Uuid
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  parent       complaints   @relation("complaint_files_parent", fields: [complaint_id], references: [id])
  file         stored_files @relation("complaint_files_file", fields: [file_id], references: [id])

  @@id([complaint_id, file_id])
  @@index([file_id], map: "complaint_files_file_idx")
  @@schema("workify")
}
