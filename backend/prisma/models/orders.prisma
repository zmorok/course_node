model orders {
  project_id           String                    @db.Uuid
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id          String                    @db.Uuid
  freelancer_id        String                    @db.Uuid
  proposal_id          String?                   @unique @db.Uuid
  invitation_id        String?                   @unique @db.Uuid
  title_snapshot       String                    @db.VarChar(200)
  description_snapshot String
  agreed_price         Decimal?                  @db.Decimal(12, 2)
  initial_deadline_at  DateTime                  @db.Timestamptz(6)
  deadline_at          DateTime                  @db.Timestamptz(6)
  status               String                    @default("IN_PROGRESS") @db.VarChar(20)
  completed_at         DateTime?                 @db.Timestamptz(6)
  cancelled_at         DateTime?                 @db.Timestamptz(6)
  cancelled_by         String?                   @db.Uuid
  cancellation_reason  String?
  created_at           DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime                  @default(now()) @db.Timestamptz(6)
  files                order_files[]             @relation("order_files_parent")
  project              projects                  @relation("orders_project", fields: [project_id], references: [id])
  customer             users                     @relation("orders_customer", fields: [customer_id], references: [id])
  freelancer           users                     @relation("orders_freelancer", fields: [freelancer_id], references: [id])
  proposal             proposals?                @relation("orders_proposal", fields: [proposal_id], references: [id])
  invitation           project_invitations?      @relation("orders_invitation", fields: [invitation_id], references: [id])
  canceller            users?                    @relation("orders_canceller", fields: [cancelled_by], references: [id])
  submissions          order_submissions[]       @relation("order_submissions_order")
  deadlines            order_deadline_requests[] @relation("order_deadline_requests_order")
  events               order_events[]            @relation("order_events_order")
  reviews              reviews[]                 @relation("reviews_order")
  complaints           complaints[]              @relation("complaints_order")

  @@unique([id, customer_id, freelancer_id])
  @@unique([id, customer_id])
  @@unique([id, freelancer_id])
  @@index([customer_id, status, created_at(sort: Desc), id], map: "orders_customer_status_idx")
  @@index([freelancer_id, status, created_at(sort: Desc), id], map: "orders_freelancer_status_idx")
  @@index([project_id, created_at(sort: Desc), id], map: "orders_project_created_idx")
  @@schema("workify")
}
