# Copy to .env and replace the password, or run: node scripts/setup-env.mjs
COMPOSE_PROJECT_NAME=workify
POSTGRES_DB=workify
POSTGRES_USER=workify
POSTGRES_PASSWORD=replace-with-your-local-password
FRONTEND_PORT=5173
BACKEND_PORT=3000

# Generate a private 32-byte key with node scripts/setup-env.mjs
AUTH_JWT_SECRET=replace-with-64-random-hex-characters
# Set true when serving the application over HTTPS
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_DAYS=30

# Backend limits; validated before the HTTP server starts
HTTP_JSON_LIMIT_BYTES=65536
PGPOOL_MAX=5
PG_CONNECTION_TIMEOUT_MS=2000
PG_IDLE_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=2000
PG_STATEMENT_TIMEOUT_MS=2000
