model auth_sessions {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String                @db.Uuid
  created_at DateTime              @default(now()) @db.Timestamptz(6)
  expires_at DateTime              @db.Timestamptz(6)
  revoked_at DateTime?             @db.Timestamptz(6)
  user       users                 @relation("auth_sessions_user", fields: [user_id], references: [id])
  tokens     auth_refresh_tokens[] @relation("auth_refresh_tokens_session")

  @@index([user_id], map: "auth_sessions_user_idx")
  @@schema("workify")
}
