model portfolio_files {
  portfolio_item_id String          @db.Uuid
  file_id           String          @db.Uuid
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  parent            portfolio_items @relation("portfolio_files_parent", fields: [portfolio_item_id], references: [id])
  file              stored_files    @relation("portfolio_files_file", fields: [file_id], references: [id])

  @@id([portfolio_item_id, file_id])
  @@index([file_id], map: "portfolio_files_file_idx")
  @@schema("workify")
}
