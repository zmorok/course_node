model submission_files {
  submission_id String            @db.Uuid
  file_id       String            @db.Uuid
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  parent        order_submissions @relation("submission_files_parent", fields: [submission_id], references: [id])
  file          stored_files      @relation("submission_files_file", fields: [file_id], references: [id])

  @@id([submission_id, file_id])
  @@index([file_id], map: "submission_files_file_idx")
  @@schema("workify")
}
