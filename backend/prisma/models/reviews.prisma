model reviews {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String         @db.Uuid
  customer_id   String         @db.Uuid
  freelancer_id String         @db.Uuid
  author_id     String         @db.Uuid
  recipient_id  String         @db.Uuid
  rating        Int            @db.SmallInt
  text          String
  deleted_at    DateTime?      @db.Timestamptz(6)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  files         review_files[] @relation("review_files_parent")
  order         orders         @relation("reviews_order", fields: [order_id], references: [id])
  author        users          @relation("reviews_author", fields: [author_id], references: [id])
  recipient     users          @relation("reviews_recipient", fields: [recipient_id], references: [id])

  @@unique([order_id, author_id])
  @@index([author_id, created_at(sort: Desc), id], map: "reviews_author_idx")
  @@index([recipient_id, created_at(sort: Desc), id], map: "reviews_recipient_idx")
  @@schema("workify")
}
