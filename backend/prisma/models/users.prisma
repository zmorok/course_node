model users {
  id                             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                          String                    @db.VarChar(254)
  username                       String                    @db.VarChar(40)
  password_hash                  String
  role                           String                    @default("CLIENT") @db.VarChar(10)
  status                         String                    @default("ACTIVE") @db.VarChar(10)
  blocked_by                     String?                   @db.Uuid
  blocked_at                     DateTime?                 @db.Timestamptz(6)
  blocked_until                  DateTime?                 @db.Timestamptz(6)
  block_reason                   String?
  last_unblocked_at              DateTime?                 @db.Timestamptz(6)
  last_online_at                 DateTime?                 @db.Timestamptz(6)
  created_at                     DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                  @default(now()) @db.Timestamptz(6)
  deleted_at                     DateTime?                 @db.Timestamptz(6)
  profile                        profiles?                 @relation("profiles_user")
  skills                         user_skills[]             @relation("user_skills_user")
  projects                       projects[]                @relation("projects_customer")
  portfolio                      portfolio_items[]         @relation("portfolio_items_user")
  uploads                        stored_files[]            @relation("stored_files_uploader")
  customer_proposals             proposals[]               @relation("proposals_customer")
  freelancer_proposals           proposals[]               @relation("proposals_freelancer")
  customer_project_invitations   project_invitations[]     @relation("project_invitations_customer")
  freelancer_project_invitations project_invitations[]     @relation("project_invitations_freelancer")
  customer_orders                orders[]                  @relation("orders_customer")
  freelancer_orders              orders[]                  @relation("orders_freelancer")
  cancelled_orders               orders[]                  @relation("orders_canceller")
  submissions                    order_submissions[]       @relation("order_submissions_freelancer")
  reviewed_submissions           order_submissions[]       @relation("order_submissions_reviewer")
  deadline_requests              order_deadline_requests[] @relation("order_deadline_requests_freelancer")
  decided_deadlines              order_deadline_requests[] @relation("order_deadline_requests_reviewer")
  order_events                   order_events[]            @relation("order_events_actor")
  written_reviews                reviews[]                 @relation("reviews_author")
  received_reviews               reviews[]                 @relation("reviews_recipient")
  reported_complaints            complaints[]              @relation("complaints_reporter")
  received_complaints            complaints[]              @relation("complaints_target")
  assigned_complaints            complaints[]              @relation("complaints_admin")
  issued_actions                 moderation_actions[]      @relation("moderation_actions_admin")
  received_actions               moderation_actions[]      @relation("moderation_actions_target")
  warnings                       warnings[]                @relation("warnings_user")
  issued_warnings                warnings[]                @relation("warnings_admin")
  notifications                  notifications[]           @relation("notifications_recipient")
  sessions                       auth_sessions[]           @relation("auth_sessions_user")
  audit                          audit_logs[]              @relation("audit_logs_actor")
  imports                        audit_imported_entries[]  @relation("audit_imported_entries_importer")

  @@index([status, created_at(sort: Desc), id], map: "users_status_created_idx")
  @@schema("workify")
}
