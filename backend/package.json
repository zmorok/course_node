{
  "name": "workify-backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "format": "prettier --write src test prisma.config.js package.json .prettierrc.json",
    "format:check": "prettier --check src test prisma.config.js package.json .prettierrc.json",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.5.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prisma": "7.10.1"
  }
}
