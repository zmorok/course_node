model project_invitations {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String    @db.Uuid
  customer_id         String    @db.Uuid
  freelancer_id       String    @db.Uuid
  message             String
  offered_price       Decimal?  @db.Decimal(12, 2)
  offered_deadline_at DateTime  @db.Timestamptz(6)
  expires_at          DateTime? @db.Timestamptz(6)
  status              String    @default("PENDING") @db.VarChar(15)
  decided_at          DateTime? @db.Timestamptz(6)
  closure_reason      String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  project             projects  @relation("project_invitations_project", fields: [project_id], references: [id])
  customer            users     @relation("project_invitations_customer", fields: [customer_id], references: [id])
  freelancer          users     @relation("project_invitations_freelancer", fields: [freelancer_id], references: [id])
  order               orders?   @relation("orders_invitation")

  @@unique([id, project_id, customer_id, freelancer_id])
  @@index([freelancer_id, status, created_at(sort: Desc), id], map: "invitations_freelancer_status_idx")
  @@index([project_id, status, created_at(sort: Desc), id], map: "invitations_project_status_idx")
  @@schema("workify")
}
