model project_skills {
  project_id String   @db.Uuid
  skill_id   String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  project    projects @relation("project_skills_project", fields: [project_id], references: [id])
  skill      skills   @relation("project_skills_skill", fields: [skill_id], references: [id])

  @@id([project_id, skill_id])
  @@index([skill_id, project_id], map: "project_skills_skill_idx")
  @@schema("workify")
}
