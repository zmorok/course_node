model moderation_actions {
  complaint_id String?     @db.Uuid
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id     String      @db.Uuid
  target_id    String?     @db.Uuid
  action_type  String      @db.VarChar(20)
  reason       String
  expires_at   DateTime?   @db.Timestamptz(6)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  admin        users       @relation("moderation_actions_admin", fields: [admin_id], references: [id])
  target       users?      @relation("moderation_actions_target", fields: [target_id], references: [id])
  complaint    complaints? @relation("moderation_actions_complaint", fields: [complaint_id], references: [id])
  warning      warnings?   @relation("warnings_action")

  @@unique([id, target_id, admin_id, action_type])
  @@index([admin_id, created_at(sort: Desc), id], map: "moderation_admin_idx")
  @@index([complaint_id, created_at, id], map: "moderation_complaint_idx")
  @@index([target_id, created_at(sort: Desc), id], map: "moderation_target_idx")
  @@schema("workify")
}
