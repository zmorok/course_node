model projects {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id         String                @db.Uuid
  category_id         String?               @db.Uuid
  title               String                @db.VarChar(200)
  description         String                @default("")
  budget              Decimal?              @db.Decimal(12, 2)
  desired_deadline_at DateTime?             @db.Timestamptz(6)
  status              String                @default("DRAFT") @db.VarChar(20)
  published_at        DateTime?             @db.Timestamptz(6)
  completed_at        DateTime?             @db.Timestamptz(6)
  cancelled_at        DateTime?             @db.Timestamptz(6)
  cancellation_reason String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  skills              project_skills[]      @relation("project_skills_project")
  customer            users                 @relation("projects_customer", fields: [customer_id], references: [id])
  category            categories?           @relation("projects_category", fields: [category_id], references: [id])
  files               project_files[]       @relation("project_files_parent")
  proposals           proposals[]           @relation("proposals_project")
  project_invitations project_invitations[] @relation("project_invitations_project")
  orders              orders[]              @relation("orders_project")

  @@unique([id, customer_id])
  @@index([customer_id, created_at(sort: Desc), id], map: "projects_customer_created_idx")
  @@schema("workify")
}
